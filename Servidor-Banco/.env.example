# Copie este arquivo para ".env" (na raiz do projeto) e preencha com os valores reais.
# O arquivo ".env" NUNCA deve ser commitado/enviado para o Git (ja esta no .gitignore).

# Credenciais do SimpleFarm (login do scraper)
SF_BASE_URL=https://simplefarm.usinapitangueiras.com.br:8050
SF_USERNAME=julianotimoteo
SF_PASSWORD=coloque-a-senha-real-aqui

# Chave de API para endpoints protegidos (POST /api/sync).
# Se nao definida, o backend gera uma chave aleatoria a cada reinicio (fica so no log).
SF_API_KEY=

# Ativar sistema de autenticacao de usuarios (login/token) do dashboard.
# Valores aceitos: true / false
AUTH_ENABLED=false

# Senhas mestras para bootstrap de admin/manager (apenas se nao houver usuarios no banco).
# Defina valores fortes. Se vazio, os seeds nao serao criados automaticamente.
SEED_ADMIN_PASSWORD=
SEED_MANAGER_PASSWORD=

# Senhas mestras adicionais aceitas no login Node.js (separadas por virgula).
# Se vazio, apenas o hash do banco sera validado.
MASTER_PASSWORDS=

# Segredo para assinatura de tokens JWT (Python).
JWT_SECRET_KEY=

# Origens permitidas para CORS (separadas por virgula). Vazio = bloquear todas.
CORS_ORIGINS=https://julianotimoteo.github.io,http://localhost:3000,http://127.0.0.1:3000
